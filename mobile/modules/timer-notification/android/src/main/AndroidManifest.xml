<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lets Android 16+ show a running timer as a Live Update (status bar chip, lock screen). -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <application>
    <!-- Hears that the user swiped a timer away (#51). Only our own delete intent reaches it. -->
    <receiver
      android:name="expo.modules.timernotification.TimerDismissedReceiver"
      android:exported="false" />
    <!-- Runs the button on a timer (#97) as a headless JS task. Only our PendingIntent starts it. -->
    <service
      android:name="expo.modules.timernotification.TimerActionService"
      android:exported="false" />
  </application>
</manifest>
