{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is production (babytracker-relay); `--env acc` deploys acceptance as a
  // separate Worker with its own Durable Object storage and secrets.
  "name": "babytracker-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY", "class_name": "Family" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family"] }],
  // iOS pushes (#6) go to the app with this bundle ID; the APNs key itself is a secret.
  "vars": { "APNS_TOPIC": "com.napchime.app" },
  "env": {
    "acc": {
      "name": "babytracker-relay-acc",
      "vars": { "APNS_TOPIC": "com.napchime.app.acc" },
      "durable_objects": {
        "bindings": [{ "name": "FAMILY", "class_name": "Family" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family"] }]
    }
  }
}
